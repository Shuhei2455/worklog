# ---------------------------------------------------------------
# backlog-clone 本番（職場VM）用の環境変数のひな形
#
# docker-compose.prod.yml と組みで使う。手順は docs/04-deploy.md。
#
#   cp .env.production.example .env
#
# 開発用(.env.example)との違い:
#   - APP_PORT / POSTGRES_PORT / REDIS_PORT / MEILI_PORT / GITEA_HTTP_PORT が無い。
#     本番は Caddy の入口と Gitea の SSH 以外を公開しないため
#   - APP_IMAGE_TAG と RUN_UID / RUN_GID が増えている
#   - 「必ず変える」印の付いた値は、持ち込んだままにしない
# ---------------------------------------------------------------

# 持ち込んだイメージのタグ。`docker load` したものと必ず一致させる。
# latest を使わないのは、どの版が動いているか分からなくなるため
APP_IMAGE_TAG=0.5.0

# コンテナを動かすUID/GID。【要確認】
# 添付ファイルのボリュームをこのユーザーで書くので、VMのログインユーザーに合わせる。
#   id -u / id -g で調べる
RUN_UID=1000
RUN_GID=1000

# ---- 入口（HTTPS・IP直打ち） ----------------------------------------
# 2026-09-14 にユーザーが決めた構成:
#   ・社内DNSに登録せず **IPアドレス直打ち**
#   ・**HTTPS** で提供
#   ・Git over SSH(2222) は**塞がれているので使わない**（HTTPSクローンのみ）
#   ・メール通知は**使わない**（社内SMTPリレーを使わない判断）

# 待ち受けるIPアドレス。【必ず変える】
# Caddy がこのホスト向けに証明書を用意し、このHost宛のリクエストだけ通す
APP_HOST=192.168.10.20

# 公開URL。【必ず変える】APP_HOST と揃える。**https で書く**
# 通知のリンクと Gitea のクローンURLがこの値で組まれる。
# 末尾にスラッシュを付けない
APP_URL=https://192.168.10.20

# 証明書の出どころ。
#   internal … Caddy内蔵のローカルCAで自己署名する。設定は不要だが
#              **ブラウザが警告を出す**。各PCに Caddy のルート証明書を入れれば消える
#              （コンテナ内の /data/caddy/pki/authorities/local/root.crt）
#   ファイル指定 … 社内CAに発行してもらう。**こちらが本筋**
#              caddy/certs/ に置いて次のように書く（パスは2つ、空白区切り）:
#              CADDY_TLS="/etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key"
#
# **公的なCAはIPアドレスに証明書を出さない。** 社内CAに頼むときは
# **subjectAltName にIPを入れてもらう**こと（CNだけでは今のブラウザが弾く）
CADDY_TLS=internal

# 入口のポート。空いていないなら変える
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Git over SSH のポート。**いまは使っていない**
# （docker-compose.prod.yml で DISABLE_SSH=true、ポートも公開していない）。
# 使える環境に移すときに戻す。戻し方は compose のコメントにある
GITEA_SSH_PORT=2222

# Git over SSH を画面とAPIに出すか。
# **職場は2222番が塞がれているので false**（つながらないURLを見せない）。
# 未設定でも false 扱い。使える環境に移すときに true にする
GIT_SSH_ENABLED=false

# PostgreSQL【必ず変える】
#   openssl rand -base64 24
# DATABASE_URL のパスワード部分も同じ値に書き換える（2か所ある）
POSTGRES_USER=backlog
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=backlog
DATABASE_URL=postgresql://backlog:CHANGE_ME@postgres:5432/backlog?schema=public

# Redis（BullMQ）
REDIS_URL=redis://redis:6379

# Meilisearch【必ず変える】
#   openssl rand -base64 32
# MEILI_ENV=production では16バイト以上のマスターキーが必須
MEILI_MASTER_KEY=CHANGE_ME
MEILI_URL=http://meilisearch:7700

# 認証（Auth.js）【必ず変える】
#   openssl rand -base64 32
# この値を変えると全員のログインセッションが切れる（パスワードは無効にならない）
AUTH_SECRET=CHANGE_ME
AUTH_TRUST_HOST=true

# 初期管理者。新規構築時のシード投入でのみ使う。【必ず変える】
# 投入後はこの値を消してよい（アプリは参照しない）
SEED_ADMIN_USER_ID=admin
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADMIN_NAME=管理者

# メール。**使わない**（2026-09-14 にユーザーが決定。社内SMTPリレーを使わない）。
# false ならアプリ内通知だけで運用が回る（メール用ワーカーごと起動しない）。
# 通知は画面の「通知」欄で成立するので、機能として欠けるのは
# 「自分が見ていないときにメールで気づく」だけ。
# 後で使う場合は true にして SMTP_HOST を埋め、worker を再起動する
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=kadai@example.local

# Gitea
# Gitea が組み立てるクローンURLのホスト名。**APP_HOST と同じIPを書く**
# （IP直打ちなので、ここもIP。ホスト名を書くと利用者が clone できない）
GITEA_DOMAIN=192.168.10.20
# APIのベースURL。Gitea 本体はルート配下で配信するので subpath は付けない
# （ROOT_URL の /git/ は Gitea が生成するリンク用。入口の Caddy が剥がす）
GITEA_URL=http://gitea:3000
# Gitea からの webhook を検証する共有鍵。openssl rand -base64 32
# 空のままだと署名を確認できないので、必ず設定する
GITEA_WEBHOOK_SECRET=CHANGE_ME
GITEA_ADMIN_TOKEN=

# 添付ファイル
FILES_DIR=/data/files
MAX_ATTACHMENT_MB=10

# APIのレート制限（1分あたり・ユーザー単位）。
# 5〜20人なら既定値のままで足りる。CSV一括投入のような使い方を
# 予定しているなら RATE_LIMIT_UPDATE を上げる
RATE_LIMIT_READ=600
RATE_LIMIT_UPDATE=150
RATE_LIMIT_SEARCH=150
RATE_LIMIT_ICON=60
