{
  "name": "backlog-clone",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "worker": "tsx watch src/worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --hostname 0.0.0.0",
    "postinstall": "prisma generate",
    "db:password": "tsx prisma/set-password.ts",
    "reindex": "tsx src/scripts/reindex.ts",
    "demo:seed": "tsx prisma/demo-seed.ts",
    "check": "node ../scripts/check-consistency.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "next-auth": "^5.0.0-beta.25",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "rehype-sanitize": "^6.0.0",
    "bullmq": "^5.34.2",
    "ioredis": "^5.4.2",
    "meilisearch": "^0.46.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "@types/nodemailer": "^6.4.17"
  },
  "packageManager": "pnpm@12.4.1"
}
