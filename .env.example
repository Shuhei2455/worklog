# ---------------------------------------------------------------
# backlog-clone 環境変数
# これが正。新しい変数を足したら必ずここにも書く（CLAUDE.md）。
# 外部SaaSに依存する設定は追加しない（職場VMは外部通信が制限される前提）。
#
# これは**開発用**（docker-compose.yml と組み）。
# 職場VM向けは .env.production.example を使う。手順は docs/04-deploy.md。
# ---------------------------------------------------------------

# 公開URL。Caddy が受ける入口
APP_URL=http://localhost:8088

# ポート（自宅サーバの既存サービスと衝突しない値を選んである。
# 8096=Jellyfin / 8123=Home Assistant / 50021=VOICEVOX などが既に使用中）
CADDY_HTTP_PORT=8088
APP_PORT=3100
GITEA_HTTP_PORT=3101
GITEA_SSH_PORT=2222
POSTGRES_PORT=5433
REDIS_PORT=6380
MEILI_PORT=7701

# PostgreSQL
POSTGRES_USER=backlog
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=backlog
DATABASE_URL=postgresql://backlog:change_me_in_env@postgres:5432/backlog?schema=public

# Redis（BullMQ）
REDIS_URL=redis://redis:6379

# Meilisearch
MEILI_MASTER_KEY=change_me_in_env
MEILI_URL=http://meilisearch:7700

# 認証（Auth.js）。openssl rand -base64 32 で生成する
AUTH_SECRET=change_me_in_env
AUTH_TRUST_HOST=true

# 初期管理者。シード投入時のみ使う
SEED_ADMIN_USER_ID=admin
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=change_me_in_env
SEED_ADMIN_NAME=管理者

# メール。職場VMではSMTPリレーが使えない可能性が高いので、
# false にすればアプリ内通知だけで運用が回るようにする。
# false のときは worker がメール用のワーカーごと起動せず、
# キューにも積まれない（接続を張って失敗し続ける状態を避けるため）。
#
# 検証するときは Mailpit のような受け取るだけのSMTPを立てると早い:
#   docker run -d --name mailpit --network host axllent/mailpit
#   MAIL_ENABLED=true / SMTP_HOST=<ホストのIP> / SMTP_PORT=1025
#   受信箱は http://localhost:8025
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=backlog-clone@example.local

# Gitea
# Gitea が組み立てるクローンURLのホスト名。APP_URL のホスト部分と合わせる
GITEA_DOMAIN=192.168.3.50
# APIのベースURL。Gitea 本体はルート配下で配信するので subpath は付けない
# （ROOT_URL の /git/ は Gitea が生成するリンク用。入口の Caddy が剥がす）
GITEA_URL=http://gitea:3000
GITEA_ADMIN_TOKEN=

# 添付ファイル
FILES_DIR=/data/files
# 本家の上限は未確認。00-spec-verified.md の決定 D9
MAX_ATTACHMENT_MB=10

# APIのレート制限（1分あたり）。本家は4種類に分けており、値はプランごとに
# 非公開なので自前で決めている（00-spec-verified.md の決定 D17）。
# 数え方は本家と同じくユーザー単位。キーを複数作っても合算される。
RATE_LIMIT_READ=600
RATE_LIMIT_UPDATE=150
RATE_LIMIT_SEARCH=150
RATE_LIMIT_ICON=60
